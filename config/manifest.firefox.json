{
  "manifest_version": 3,
  "name": "DSA Coach",
  "short_name": "DSA Coach",
  "description": "A private memory system for data structures and algorithms interview preparation.",
  "homepage_url": "https://github.com/AARNAV-ARYA/DSA-Coach",
  "version": "0.2.0",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open DSA Coach",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "scripts": ["background/service-worker.js"],
    "type": "module"
  },
  "sidebar_action": {
    "default_title": "DSA Coach",
    "default_panel": "sidepanel.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "open-dashboard": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Alt+Shift+D"
      },
      "description": "Open the DSA Coach dashboard"
    },
    "open-capture": {
      "suggested_key": {
        "default": "Alt+Shift+A",
        "mac": "Alt+Shift+A"
      },
      "description": "Open problem capture for the current tab"
    }
  },
  "permissions": ["activeTab", "alarms", "notifications", "storage"],
  "host_permissions": ["https://leetcode.com/*"],
  "optional_host_permissions": ["http://127.0.0.1:8787/*"],
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/*"],
      "js": ["content/problem-context.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "incognito": "not_allowed",
  "browser_specific_settings": {
    "gecko": {
      "id": "dsa-coach@aarnavarya",
      "strict_min_version": "121.0"
    }
  }
}
